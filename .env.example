# Copy to .env for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional override for business routes (usually not needed).
# NEXT_PUBLIC_BUSINESS_API_BASE_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://api.inventomanager.com/api

# Never put EPS_PASSWORD, EPS_HASH_KEY, or any gateway secret in a
# NEXT_PUBLIC_* variable. They are backend-only.
