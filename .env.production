# Production API (EPS-enabled backend).
# `next build` / `next start` load this file automatically and it overrides .env.
NEXT_PUBLIC_API_BASE_URL=https://api.inventomanager.com/api

# Optional: set only if the business API is on a different host/path.
# NEXT_PUBLIC_BUSINESS_API_BASE_URL=https://api.inventomanager.com

# EPS secrets must stay on the backend. Do not add them here.
